# Copiez ce fichier en ".env" et remplissez les valeurs réelles.
# Ne JAMAIS committer le fichier ".env" (voir .gitignore).

# URL de connexion PostgreSQL (ex: Neon, Railway, ou local)
DATABASE_URL="postgresql://user:password@localhost:5432/smart_campus"

# Port du serveur backend
PORT=4000

# Secret utilisé pour signer les tokens JWT (Sprint 1)
JWT_SECRET="change-moi-avec-une-chaine-aleatoire-longue"
