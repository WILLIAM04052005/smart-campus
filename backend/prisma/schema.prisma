// ============================================================
// Schéma de base de données - Smart Campus (NextCampus)
//
// Sprint 0 : on pose les fondations (User, Role, Class).
// Les entités Subject, Schedule, Absence, Grade, Announcement,
// Resource, Booking seront ajoutées au fil des sprints suivants
// (voir 01-cahier-des-charges.md, section 5 et 6).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // stocké hashé (bcrypt) - jamais en clair
  firstName String
  lastName  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un étudiant appartient à une classe (nullable pour enseignants/admins)
  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  // Relations inverses (un enseignant peut enseigner plusieurs matières ;
  // un étudiant peut avoir plusieurs absences/notes)
  subjectsTaught         Subject[]
  absences               Absence[]      @relation("StudentAbsences")
  grades                 Grade[]        @relation("StudentGrades")
  announcementsAuthored  Announcement[] @relation("AnnouncementsAuthored")
  bookings               Booking[]      @relation("UserBookings")

  @@map("users")
}

model Class {
  id        String   @id @default(uuid())
  name      String   // ex: "DEV-B3-A"
  year      Int      // ex: 2026 (année de promotion)
  createdAt DateTime @default(now())

  students User[]
  subjects Subject[]
  schedule ScheduleEntry[]
  announcements Announcement[]

  @@map("classes")
}

// Une matière est rattachée à une classe et à un enseignant (optionnel
// à la création : un admin peut créer la matière avant d'assigner
// l'enseignant).
model Subject {
  id        String   @id @default(uuid())
  name      String   // ex: "Développement Web"
  createdAt DateTime @default(now())

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   User?   @relation(fields: [teacherId], references: [id])

  schedule ScheduleEntry[]
  absences Absence[]
  grades   Grade[]

  @@map("subjects")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

// Un créneau récurrent dans l'emploi du temps (ex : "Développement Web,
// tous les lundis de 9h à 12h, salle B12").
model ScheduleEntry {
  id        String    @id @default(uuid())
  dayOfWeek DayOfWeek
  startTime String    // format "HH:mm", ex: "09:00"
  endTime   String    // format "HH:mm", ex: "12:00"
  room      String

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("schedule_entries")
}

model Absence {
  id        String   @id @default(uuid())
  date      DateTime
  justified Boolean  @default(false)
  comment   String?
  createdAt DateTime @default(now())

  studentId String
  student   User   @relation("StudentAbsences", fields: [studentId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("absences")
}

model Grade {
  id        String   @id @default(uuid())
  value     Float    // note obtenue
  maxValue  Float    @default(20) // barème, 20 par défaut
  comment   String?
  date      DateTime @default(now())

  studentId String
  student   User   @relation("StudentGrades", fields: [studentId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("grades")
}

// Une annonce est soit globale (classId = null, visible de tous), soit
// ciblée sur une classe précise. Publiée par un enseignant ou un admin.
model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation("AnnouncementsAuthored", fields: [authorId], references: [id], onDelete: Cascade)

  classId String? // null = annonce globale, visible par tout le monde
  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

enum ResourceType {
  ROOM
  EQUIPMENT
}

// Une ressource réservable : salle de travail, vidéoprojecteur, etc.
model Resource {
  id       String       @id @default(uuid())
  name     String
  type     ResourceType
  capacity Int? // pertinent pour une salle, pas pour du matériel

  bookings Booking[]

  @@map("resources")
}

model Booking {
  id        String   @id @default(uuid())
  date      DateTime // jour de la réservation
  startTime String   // format "HH:mm"
  endTime   String   // format "HH:mm"
  purpose   String?
  createdAt DateTime @default(now())

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserBookings", fields: [userId], references: [id], onDelete: Cascade)

  @@map("bookings")
}
